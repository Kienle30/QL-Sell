<Window x:Class="QuanLyBanHang.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Bán Hàng Pro" Height="780" Width="1350" WindowStartupLocation="CenterScreen" Background="#F4F7F6"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#007BFF"/>
        </Style>
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="0,5,15,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton" x:Key="MenuBtnStyle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E9ECEF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton" x:Key="SubMenuBtnStyle" BasedOn="{StaticResource MenuBtnStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="20,0,10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style TargetType="CheckBox" x:Key="MenuDropdownStyle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="icon" DockPanel.Dock="Right" Text="▼" FontSize="11" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E9ECEF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="icon" Property="Text" Value="▲"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,0,1,0">
            <StackPanel>
                <Border Padding="15,25,15,30">
                    <StackPanel>
                        <TextBlock Text="PRO SALES" FontSize="22" FontWeight="Black" Foreground="#007BFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtWelcome" Text="Chào Admin" FontSize="13" Foreground="#6C757D" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <RadioButton x:Name="menuKho" Content="📦 NHẬP KHO" Style="{StaticResource MenuBtnStyle}" IsChecked="{Binding IsSelected, ElementName=tabKho}"/>
                <RadioButton x:Name="menuBan" Content="💰 BÁN HÀNG" Style="{StaticResource MenuBtnStyle}" IsChecked="{Binding IsSelected, ElementName=tabBan}"/>

                <StackPanel x:Name="menuThongKePanel">
                    <CheckBox x:Name="chkThongKe" Content="📊 THỐNG KÊ" Style="{StaticResource MenuDropdownStyle}"/>
                    <StackPanel Visibility="{Binding IsChecked, ElementName=chkThongKe, Converter={StaticResource BoolToVis}}" Margin="0,5,0,5">
                        <RadioButton x:Name="menuTKBan" Content="📈 Bán Hàng" Style="{StaticResource SubMenuBtnStyle}" IsChecked="{Binding IsSelected, ElementName=tabTKBan}"/>
                        <RadioButton x:Name="menuTKNhap" Content="📉 Nhập Hàng" Style="{StaticResource SubMenuBtnStyle}" IsChecked="{Binding IsSelected, ElementName=tabTKNhap}"/>
                    </StackPanel>
                </StackPanel>

                <RadioButton x:Name="menuHeThong" Content="⚙️ HỆ THỐNG" Style="{StaticResource MenuBtnStyle}" IsChecked="{Binding IsSelected, ElementName=tabHeThong}"/>

                <Border Height="1" Background="#DEE2E6" Margin="15,20"/>
                <Button Content="🔄 ĐĂNG XUẤT" Click="btnDangXuat_Click" Background="Transparent" Foreground="#DC3545" FontSize="14" FontWeight="Bold" Margin="15,0" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="15" SelectionChanged="MainTabControl_SelectionChanged">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabItem x:Name="tabKho">
                <Grid Background="White" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F1F8E9" Padding="15,10" CornerRadius="8" Margin="0,0,0,15" BorderBrush="#C5E1A5" BorderThickness="1">
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="btnMoTaoSanPham" Content="📦 TẠO SP MỚI" Click="btnMoTaoSanPham_Click" Style="{StaticResource ActionButtonStyle}" Background="#E83E8C"/>
                            <Button Content="📥 TẠO PHIẾU NHẬP" Click="btnThem_Click" Style="{StaticResource ActionButtonStyle}" Background="#28A745"/>
                            <Button x:Name="btnSua" Content="📝 SỬA DÒNG" Click="btnSua_Click" Style="{StaticResource ActionButtonStyle}" Background="#FFC107" Foreground="Black"/>
                            <Button x:Name="btnXoa" Content="🗑️ XÓA DÒNG" Click="btnXoa_Click" Style="{StaticResource ActionButtonStyle}" Background="#F44336"/>
                            <Button x:Name="btnImportExcel" Content="📥 ĐỒNG BỘ .XLSX" Click="btnImportExcel_Click" Style="{StaticResource ActionButtonStyle}" Background="#17A2B8"/>
                            <Button x:Name="btnExportData" Content="📤 XUẤT BÁO CÁO" Click="btnExportData_Click" Style="{StaticResource ActionButtonStyle}" Background="#6F42C1"/>
                            <Button x:Name="btnExportTemplate" Content="📑 XUẤT FORM MẪU" Click="btnExportTemplate_Click" Style="{StaticResource ActionButtonStyle}" Background="#20c997"/>
                            <Button Content="🚫 BỎ LỌC DỮ LIỆU" Click="btnClearAllFilters_Click" Style="{StaticResource ActionButtonStyle}" Background="#6C757D"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="dgKhoHang" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" AutoGeneratingColumn="dgKhoHang_AutoGeneratingColumn" AlternatingRowBackground="#F9F9F9" RowHeight="36" ColumnHeaderHeight="42">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#C5E1A5"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="▼" Width="22" Height="22" FontSize="10" Tag="{Binding}" Click="btnOpenFilter_Click" Background="#E0E0E0" BorderThickness="0" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                    <Border Grid.Row="2" Background="#E8F5E9" Padding="20,12" CornerRadius="8" HorizontalAlignment="Right" Margin="0,15,0,0" BorderBrush="#4CAF50" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰 TỔNG GIÁ TRỊ KHO TỒN: " FontSize="18" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTongGiaTriKho" Text="0 VNĐ" FontSize="24" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabBan">
                <Grid Background="White" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FFF3E0" Padding="15,10" CornerRadius="8" Margin="0,0,0,15" BorderBrush="#FFE0B2" BorderThickness="1">
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="🛒 TẠO ĐƠN BÁN MỚI" Click="btnMoTaoDonBan_Click" Style="{StaticResource ActionButtonStyle}" Background="#FD7E14"/>
                            <Button x:Name="btnSuaBanHang" Content="📝 SỬA GIAO DỊCH" Click="btnMoSuaDonBan_Click" Style="{StaticResource ActionButtonStyle}" Background="#FFC107" Foreground="Black"/>
                            <Button x:Name="btnXoaBanHang" Content="🗑️ XÓA GIAO DỊCH" Click="btnXoaBanHang_Click" Style="{StaticResource ActionButtonStyle}" Background="#DC3545"/>
                            <Button Content="🚫 BỎ LỌC DỮ LIỆU" Click="btnClearAllFilters_Click" Style="{StaticResource ActionButtonStyle}" Background="#6C757D"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="dgBanHang" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" AutoGeneratingColumn="dgBanHang_AutoGeneratingColumn" AlternatingRowBackground="#FFF8E1" RowHeight="36" ColumnHeaderHeight="42">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFE0B2"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="▼" Width="22" Height="22" FontSize="10" Tag="{Binding}" Click="btnOpenFilter_Click" Background="#E0E0E0" BorderThickness="0" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabTKBan">
                <Grid Background="White" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#E3F2FD" Padding="15,10" CornerRadius="8" Margin="0,0,0,15" BorderBrush="#81D4FA" BorderThickness="1">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Năm:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbNamTK" Width="100" Height="38" FontSize="15" FontWeight="Bold" SelectionChanged="cmbThongKe_SelectionChanged"/>
                            <TextBlock Text="Tháng:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,10,0"/>
                            <ComboBox x:Name="cmbThangTK" Width="120" Height="38" FontSize="15" FontWeight="Bold" SelectionChanged="cmbThongKe_SelectionChanged"/>

                            <Border Width="2" Background="#81D4FA" Margin="20,0,20,0" CornerRadius="1"/>
                            <Button Content="📤 XUẤT DỮ LIỆU" Click="btnExportThongKeBan_Click" Style="{StaticResource ActionButtonStyle}" Background="#17A2B8"/>
                            <Button Content="🚫 BỎ LỌC DỮ LIỆU" Click="btnClearAllFilters_Click" Style="{StaticResource ActionButtonStyle}" Background="#6C757D"/>
                        </WrapPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5.5*"/>
                            <ColumnDefinition Width="4.5*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="dgThongKe" Grid.Column="0" AutoGenerateColumns="True" IsReadOnly="True" AutoGeneratingColumn="dgThongKe_AutoGeneratingColumn" AlternatingRowBackground="#F9FBE7" RowHeight="36" ColumnHeaderHeight="42">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#81D4FA"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Right" Content="▼" Width="22" Height="22" FontSize="10" Tag="{Binding}" Click="btnOpenFilter_Click" Background="#E0E0E0" BorderThickness="0" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>
                        <Border Grid.Column="1" Background="#FFFFFF" Margin="15,0,0,0" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="txtChartTitle" Text="Biểu đồ Doanh Thu Cả Năm" FontSize="18" FontWeight="Bold" Foreground="#0277BD" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <ItemsControl x:Name="icChart" Grid.Row="1" VerticalAlignment="Bottom" Height="260">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Bottom" Margin="4,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Rectangle Grid.Row="0" Fill="#007BFF" Height="{Binding ChartHeight}" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4" ToolTip="{Binding ValueString}">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Fill" Value="#FD7E14"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <TextBlock Grid.Row="1" Text="{Binding MonthLabel}" TextAlignment="Center" Margin="0,5,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#495057"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="#FFF3E0" Padding="20,12" CornerRadius="8" HorizontalAlignment="Right" Margin="0,15,0,0" BorderBrush="#FFE0B2" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 DOANH THU: " FontSize="16" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTongDoanhThuTK" Text="0 VNĐ" FontSize="20" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center" Margin="5,0,25,0"/>
                            <Border Width="2" Background="#FFCC80" Margin="0,0,25,0"/>
                            <TextBlock Text="💵 LÃI/LỖ: " FontSize="18" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTongLaiLoTK" Text="0 VNĐ" FontSize="24" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabTKNhap">
                <Grid Background="White" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F4F6F6" Padding="15,10" CornerRadius="8" Margin="0,0,0,15" BorderBrush="#D5D8DC" BorderThickness="1">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Năm:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbNamTKNhap" Width="100" Height="38" FontSize="15" FontWeight="Bold" SelectionChanged="cmbThongKe_SelectionChanged"/>
                            <TextBlock Text="Tháng:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,10,0"/>
                            <ComboBox x:Name="cmbThangTKNhap" Width="120" Height="38" FontSize="15" FontWeight="Bold" SelectionChanged="cmbThongKe_SelectionChanged"/>

                            <Border Width="2" Background="#D5D8DC" Margin="20,0,20,0" CornerRadius="1"/>
                            <Button Content="📤 XUẤT DỮ LIỆU" Click="btnExportThongKeNhap_Click" Style="{StaticResource ActionButtonStyle}" Background="#1E8449"/>
                            <Button Content="🚫 BỎ LỌC DỮ LIỆU" Click="btnClearAllFilters_Click" Style="{StaticResource ActionButtonStyle}" Background="#6C757D"/>
                        </WrapPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5.5*"/>
                            <ColumnDefinition Width="4.5*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="dgThongKeNhap" Grid.Column="0" AutoGenerateColumns="True" IsReadOnly="True" AutoGeneratingColumn="dgThongKe_AutoGeneratingColumn" AlternatingRowBackground="#EAFAF1" RowHeight="36" ColumnHeaderHeight="42">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#A9DFBF"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Right" Content="▼" Width="22" Height="22" FontSize="10" Tag="{Binding}" Click="btnOpenFilter_Click" Background="#E0E0E0" BorderThickness="0" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>
                        <Border Grid.Column="1" Background="#FFFFFF" Margin="15,0,0,0" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="txtChartTitleNhap" Text="Biểu đồ Nhập Hàng Cả Năm" FontSize="18" FontWeight="Bold" Foreground="#117864" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <ItemsControl x:Name="icChartNhap" Grid.Row="1" VerticalAlignment="Bottom" Height="260">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Bottom" Margin="4,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Rectangle Grid.Row="0" Fill="#1ABC9C" Height="{Binding ChartHeight}" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4" ToolTip="{Binding ValueString}">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Fill" Value="#117864"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <TextBlock Grid.Row="1" Text="{Binding MonthLabel}" TextAlignment="Center" Margin="0,5,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#495057"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="#E8F8F5" Padding="20,12" CornerRadius="8" HorizontalAlignment="Right" Margin="0,15,0,0" BorderBrush="#1ABC9C" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦 TỔNG TIỀN NHẬP: " FontSize="18" FontWeight="Bold" Foreground="#117864" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTongTienNhapTK" Text="0 VNĐ" FontSize="24" FontWeight="Bold" Foreground="#117864" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabHeThong">
                <Grid Background="White" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#F3F4F6" Padding="15,10" CornerRadius="12" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="➕ THÊM USER" Click="btnAddUser_Click" Style="{StaticResource ActionButtonStyle}" Background="#28A745"/>
                            <Button Content="📝 SỬA USER" Click="btnEditUser_Click" Style="{StaticResource ActionButtonStyle}" Background="#FFC107" Foreground="Black"/>
                            <Button Content="🗑️ XÓA USER" Click="btnDeleteUser_Click" Style="{StaticResource ActionButtonStyle}" Background="#DC3545"/>
                            <Button x:Name="btnXemLog" Content="📜 XEM LOG SỬA ĐƠN" Click="btnXemLog_Click" Style="{StaticResource ActionButtonStyle}" Background="#6C757D"/>
                            <Button Content="⏪ PHỤC HỒI DỮ LIỆU" Click="btnRestore_Click" Style="{StaticResource ActionButtonStyle}" Background="#6F42C1"/>
                        </WrapPanel>
                    </Border>
