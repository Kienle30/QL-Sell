            </Border>
        </Grid>

        <Border x:Name="SearchBox" Grid.Column="1" Visibility="Collapsed" Background="White" BorderBrush="#007BFF" BorderThickness="2" CornerRadius="8" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,30,0" Panel.ZIndex="9999" Width="330">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="10" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                <TextBox x:Name="txtSearchInput" Width="160" Height="32" VerticalContentAlignment="Center" FontSize="14" TextChanged="txtSearchInput_TextChanged" KeyDown="txtSearchInput_KeyDown" BorderBrush="#CED4DA" Padding="5,0"/>
                <TextBlock x:Name="txtSearchMatchCount" Text="0/0" Width="45" TextAlignment="Center" VerticalAlignment="Center" Foreground="#6C757D" FontWeight="Bold" Margin="5,0"/>
                <Button Content="▲" Click="btnSearchPrev_Click" Width="26" Height="32" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" Cursor="Hand" Margin="2,0"/>
                <Button Content="▼" Click="btnSearchNext_Click" Width="26" Height="32" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" Cursor="Hand" Margin="2,0,5,0"/>
                <Button Content="❌" Click="btnSearchClose_Click" Width="25" Height="32" Background="Transparent" BorderThickness="0" Foreground="#DC3545" FontSize="12" Cursor="Hand"/>
            </StackPanel>
        </Border>
        <!-- OVERLAY CẢNH BÁO HÀNG SẮP HẾT -->
        <Grid x:Name="OverlayCanhBao" Visibility="Collapsed" Grid.ColumnSpan="10" Panel.ZIndex="999">
            <!-- Lớp nền mờ phía sau -->
            <Border Background="#80000000" MouseDown="btnDongCanhBao_MouseDown"/>

            <!-- Khung thông báo chính -->
            <Border Background="White" CornerRadius="15" Width="700" Height="450" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề -->
                    <Border Background="#e74c3c" CornerRadius="15,15,0,0" Padding="15">
                        <TextBlock Text="🔔 CẢNH BÁO HÀNG SẮP HẾT / ĐÃ HẾT KHO" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Bảng hiển thị dữ liệu -->
                    <DataGrid x:Name="dgHangSapHet" Grid.Row="1" Margin="15" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="White" BorderBrush="#DDDDDD" GridLinesVisibility="Horizontal" RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding TenSP}" Width="*"/>

                            <DataGridTextColumn Header="Tồn Kho" Binding="{Binding TonKho}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Trạng Thái ép màu tự động -->
                            <DataGridTemplateColumn Header="Trạng Thái" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TrangThai}" Foreground="{Binding MauTrangThai}" 
                                           FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Nút đóng -->
                    <Button Grid.Row="2" Content="ĐÓNG THÔNG BÁO" Click="btnDongCanhBao_Click" 
                    Width="150" Height="40" Margin="0,0,15,15" HorizontalAlignment="Right"
                    Background="#95a5a6" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>