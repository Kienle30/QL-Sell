<Window x:Class="QuanLyBanHang.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập Hệ Thống" Height="522" Width="651" WindowStartupLocation="CenterScreen" Background="#F0F2F5" ResizeMode="NoResize">

    <Border Padding="30,30,30,45" Background="White" CornerRadius="12" Margin="25">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="15" ShadowDepth="3"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PRO SALES" FontSize="32" FontWeight="Black" Foreground="#007BFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Đăng nhập hệ thống quản lý" FontSize="14" Foreground="#6C757D" HorizontalAlignment="Center" Margin="0,0,0,35"/>

            <TextBlock Text="Tài khoản:" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,8" FontSize="14"/>
            <TextBox x:Name="txtUsername" Height="45" VerticalContentAlignment="Center" FontSize="15" Padding="15,0" Margin="0,0,0,20" BorderBrush="#CED4DA" Background="#F8F9FA"/>

            <TextBlock Text="Mật khẩu:" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,8" FontSize="14"/>
            <PasswordBox x:Name="txtPassword" Height="45" VerticalContentAlignment="Center" FontSize="15" Padding="15,0" Margin="0,0,0,35" BorderBrush="#CED4DA" Background="#F8F9FA" KeyDown="txtPassword_KeyDown" 
             GotFocus="txtPassword_GotFocus"
             LostFocus="txtPassword_LostFocus"/>
            <Popup x:Name="popCapsLock" PlacementTarget="{Binding ElementName=txtPassword}" Placement="Bottom" AllowsTransparency="True" StaysOpen="True" Margin="0,2,0,0">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/> <!-- Dòng này để chứa cái mũi tên chỉ lên -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Vẽ cái mũi tên chỉ lên ô Password -->
        <Polygon Points="10,10 20,10 15,0" Fill="White" Stroke="#D3D3D3" StrokeThickness="1" HorizontalAlignment="Left" Margin="20,0,0,-1" Panel.ZIndex="2"/>

        <!-- Khung nội dung chính -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D3D3D3" BorderThickness="1" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="⚠️" Foreground="#E7C12C" Margin="0,0,5,0"/>
                    <TextBlock Text="Caps Lock is On" FontWeight="Bold" Foreground="#333333"/>
                </StackPanel>
                <TextBlock Text="Having Caps Lock on may cause you to enter your password incorrectly." TextWrapping="Wrap" MaxWidth="300" FontSize="12" Foreground="#555555" Margin="0,0,0,10"/>
                <TextBlock Text="You should press Caps Lock to turn it off before entering your password." TextWrapping="Wrap" MaxWidth="300" FontSize="12" Foreground="#555555"/>
            </StackPanel>
        </Border>
    </Grid>
</Popup>
            <TextBlock x:Name="txtCapsLockWarning" Text="⚠️ Đang bật Caps Lock!" 
           Foreground="Red" FontSize="12" Margin="0,5,0,0" 
           HorizontalAlignment="Center" Visibility="Collapsed" />

            <Button Content="ĐĂNG NHẬP" Click="btnLogin_Click" Height="50" Background="#007BFF" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>